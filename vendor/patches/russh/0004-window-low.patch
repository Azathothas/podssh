+    assert_eq!(adjusts(&mut session), vec![], "12 KiB left is not under 12 KiB");
+    session.process_packet(&mut handler, &extended(id, 2 * KIB)).await.unwrap();
+    assert_eq!(adjusts(&mut session), vec![(40 + id.0, 6 * KIB)]);
+}
