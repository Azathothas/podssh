+/// The data of a global request's reply that its request needs none of.
+/// RFC 4254, section 4, lets a success carry "response specific data", and
+/// a server of Go's x/crypto/ssh puts data in a failure too
+/// (`Request.Reply(false, payload)`). OpenSSH's client reads none of it and
+/// keeps the connection, so the rest is dropped here, never an error.
+fn drop_reply_data(reply: &str, r: &impl Reader) {
+    if !r.is_finished() {
+        debug!(
+            "{reply}: {} bytes after the reply's type, dropped",
+            r.remaining_len()
+        );
+    }
+}
