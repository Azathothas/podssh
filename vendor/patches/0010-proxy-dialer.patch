+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    /// ⛔ **`dial_tcp` routes through the proxy when one is configured.** If the
+    /// branch is removed, this dials `target.invalid` direct, which fails —
