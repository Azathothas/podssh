 //! Increment 2 (E39): the CONNECT proxy dialer, against a fake proxy.
 //!
-//! Each test scopes the global: configure, use, reset in the same test, so
-//! no configuration leaks into a neighbour running on another thread.
+//! `configure` is process-global, so the async tests serialize on `SERIAL`:
+//! two tests configuring concurrently dial each other's fake proxy (RST on
+//! Windows loopback). Each async test also resets the global on exit.
 
 use tokio::io::{AsyncReadExt, AsyncWriteExt};
 use tokio::net::TcpListener;
 use ts_http_util::proxy::{ProxyConfig, configure, connect};
 
+/// ⛔ The four async tests hold this for their whole body. `configure` sets
+/// one global dialer; without the guard, neighbours interleave configure and
+/// `connect` and read each other's listeners. Poison-tolerant: a panicking
+/// test must not wedge the rest of the suite.
+static SERIAL: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+fn serial() -> std::sync::MutexGuard<'static, ()> {
+    SERIAL.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+}
