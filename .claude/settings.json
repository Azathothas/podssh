{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "Workflow",
      "Monitor",
      "ToolSearch",
      "mcp__github",
      "mcp__github__*",
      "mcp__claude-code-remote",
      "mcp__claude-code-remote__*",
      "mcp__Claude_Docs",
      "mcp__Claude_Docs__*"
