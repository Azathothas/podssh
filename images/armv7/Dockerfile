# The system that builds and runs the binary of a 32-bit Raspberry Pi,
# armv7-unknown-linux-musleabihf (T-218): Alpine's own rust and cargo for
# armv7, run as linux/arm/v7 on an arm64 runner. The image of the gate has no
# variant for 32-bit ARM. The digest is that of the multi-platform index; the
# job picks linux/arm/v7 from it.
FROM docker.io/library/alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
