# T-679: a part of the run is read whatever its version, so a binary reads a
# key or a tunnel in bytes of another layout as its own; the test of a part of
# another version must fail.
ENTRY=T-679
GROUP=cli-tests
EXPECT='test node_upgrade::parts::tests::a_part_of_another_version_is_left \.\.\. FAILED'
RUN='cargo test --locked -p podssh-cli --lib -- node_upgrade::parts::tests::a_part_of_another_version_is_left'
