# T-679: the quick tunnel that a node keeps for the binary after its upgrade
# leaves its secret out, so that binary registers the tunnel with no secret,
# which the edge refuses; the test of a kept tunnel that comes back whole must
# fail.
ENTRY=T-679
GROUP=cli-tests
EXPECT='test node_quick::kept_tunnel::tests::a_kept_tunnel_comes_back_whole \.\.\. FAILED'
RUN='cargo test --locked -p podssh-cli --lib -- node_quick::kept_tunnel::tests::a_kept_tunnel_comes_back_whole'
