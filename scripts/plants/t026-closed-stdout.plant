# T-026: a closed stdout with no status after STATUS_WAIT ends as status 0 (the
# old rule); 'yes' into 'head -c 1' then gives 0 where OpenSSH gives 255.
# SETUP stops what an earlier interop run of this container left running.
ENTRY=T-026
GROUP=ssh-faults
EXPECT='^FAIL +status\.(as_openssh|no_success)\.yes '
RUN='RUSTFLAGS=-Ctarget-feature=+crt-static CARGO_PROFILE_RELEASE_LTO=false CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 cargo build --locked --release --target "$TARGET" -p podssh-cli && INTEROP_ONLY=status sh scripts/interop.sh "$BIN"'
SETUP='for p in sshd sshd-session sshd.pam dropbear python3 podssh tmux ssh-agent Xvfb Xvnc x0vncserver; do pkill -x "$p"; done; true'
LIMIT=3600
