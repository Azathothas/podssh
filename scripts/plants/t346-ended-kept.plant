# T-346: a list past its not_after still holds, so an old list that a key
# signed comes back for ever; the test of an old not_after must fail.
ENTRY=T-346
GROUP=cli-tests
EXPECT='test pool::signed::tests::an_old_not_after_keeps_the_parent_domain_alone \.\.\. FAILED'
RUN='cargo test --locked -p podssh-relay --lib pool'
LIMIT=1800
