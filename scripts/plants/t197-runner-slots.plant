# T-197: the runner of the queue ignores the count of slots (the entry's own
# plant); two jobs then run at once, and the test of one slot must fail. The
# gate's job.queue.slots looks once, before the runner's second look.
ENTRY=T-197
GROUP=cli-tests
EXPECT='test three_jobs_with_one_slot_run_one_at_a_time_and_the_last_gives_5 \.\.\. FAILED'
SETUP='apk add --no-cache tmux'
RUN='PODSSH_TEST_TMUX=/usr/bin/tmux cargo test --locked -p podssh-cli --test job_queue -- three_jobs_with_one_slot_run_one_at_a_time_and_the_last_gives_5'
LIMIT=2400
