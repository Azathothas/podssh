# T-433: the node reads its share file once, as it starts, so a share added
# while it runs is never reached; the test of a share added while the node
# runs must fail with its words.
ENTRY=T-433
GROUP=cli-tests
EXPECT='a share added while the node runs was not reached'
# The stand-in relay is Python's, and the build image has none: with no SETUP the
# test said it did not run, and passed.
SETUP='if command -v apk >/dev/null; then apk add --no-cache python3 openssl >/dev/null; fi'
RUN='cargo test --locked -p podssh-cli --test share -- a_share_added_while_the_node_runs_is_reached_at_its_next_session'
