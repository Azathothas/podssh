# T-441: the path prefix of the secret file is not sent; podssh sends
# wstunnel's default prefix, and the stand-in server, which restricts the
# prefix, refuses the tunnel with its 400: the test of the secret must fail
# with the refusal said in the words of wstunnel 10 and later.
ENTRY=T-441
GROUP=resume
EXPECT='Refused \{ status: 400, words: "Invalid request; the words of wstunnel 10 and later'
RUN='cargo test --locked -p podssh-ws --test wstunnel -- the_secret_goes_in_the_path_and_a_wrong_one_is_refused_in_its_words'
