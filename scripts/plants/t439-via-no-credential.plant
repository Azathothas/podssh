# T-439: the credential of --via is left out of each CONNECT, on HTTP/1.1
# and on HTTP/2; the stand-in proxy answers 407, and the test of the
# credential must fail with the 407 said in its words.
ENTRY=T-439
GROUP=resume
EXPECT='refused CONNECT 127\.0\.0\.1:[0-9]+: 407 Proxy Authentication Required; it asks for Basic'
RUN='cargo test --locked -p podssh-ws --test via -- the_credential_goes_with_each_connect_and_a_407_says_what_is_missing'
