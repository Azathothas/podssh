# T-615: the first use of the stop token to come makes it nothing, so the
# stop token before it stays; the test of the rotation, whose old token must
# get 403 after the new one's use, must fail.
ENTRY=T-615
GROUP=resume
EXPECT='test a_rotated_stop_token_ends_the_one_before_at_the_first_use_of_the_new_one \.\.\. FAILED'
RUN='cargo test --locked -p podssh-relay --features serve,plain-ws --test relay_serve_once -- a_rotated_stop_token_ends_the_one_before_at_the_first_use_of_the_new_one'
