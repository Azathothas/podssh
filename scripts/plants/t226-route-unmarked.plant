# T-226: a session that a grant let in opens its target unmarked, so the
# route's own check of the key refuses what the grant named; the test of a
# route's grant, whose target must open as a grant's, must fail.
ENTRY=T-226
GROUP=resume
EXPECT='test a_grant_names_its_route_and_stands_for_the_key_s_line \.\.\. FAILED'
RUN='cargo test --locked -p podssh-relay --features pair,grant --test grant -- a_grant_names_its_route_and_stands_for_the_key_s_line'
