# T-188: the host picker is shown when stdout alone is a terminal; with stdin
# from /dev/null it then asks on the pty, where no question and exit 64 are due.
# SETUP stops what an earlier interop run of this container left running.
ENTRY=T-188
GROUP=ssh-pty
EXPECT='^FAIL +pty\.picker\.stdout_alone '
RUN='RUSTFLAGS=-Ctarget-feature=+crt-static CARGO_PROFILE_RELEASE_LTO=false CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 cargo build --locked --release --target "$TARGET" -p podssh-cli && INTEROP_ONLY=ptyrun sh scripts/interop.sh "$BIN"'
SETUP='for p in sshd sshd-session sshd.pam dropbear python3 podssh tmux ssh-agent Xvfb Xvnc x0vncserver; do pkill -x "$p"; done; true'
LIMIT=3600
