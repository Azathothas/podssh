# T-279: set_binding keeps nothing, so -A sends no session-bind; OpenSSH's agent
# takes the connection as local and lists id_ecdsa, which ssh-add -h keeps.
# SETUP stops what an earlier interop run of this container left running.
ENTRY=T-279
GROUP=ssh-keys
EXPECT='^FAIL +agent\.openssh\.bound_key '
RUN='RUSTFLAGS=-Ctarget-feature=+crt-static CARGO_PROFILE_RELEASE_LTO=false CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 cargo build --locked --release --target "$TARGET" -p podssh-cli && INTEROP_ONLY=agent sh scripts/interop.sh "$BIN"'
SETUP='for p in sshd sshd-session sshd.pam dropbear python3 podssh tmux ssh-agent Xvfb Xvnc x0vncserver; do pkill -x "$p"; done; true'
LIMIT=3600
