# T-346: the relay role's /relays.json carries no signed list, whatever
# --deployment names, so no client learns the deployment; the test through
# the role on the loopback (Python and openssl for the harness's
# certificates) must fail.
ENTRY=T-346
GROUP=resume-cli
EXPECT='a_role_s_signed_list_names_a_deployment_outside_the_domain \.\.\. FAILED'
SETUP='{ command -v python3 && command -v openssl; } >/dev/null || apk add --no-cache python3 openssl'
RUN='cargo test --locked -p podssh-cli --test relay -- a_role_s_signed_list_names_a_deployment_outside_the_domain'
LIMIT=1800
