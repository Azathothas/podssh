# T-228: the secret that podssh agent gives back is logged at debug level; the
# run with -vvv then holds podtest's password, which the check must find.
# SETUP stops what an earlier interop run of this container left running.
ENTRY=T-228
GROUP=ssh-keys
EXPECT='^FAIL +agent\.store\.password '
RUN='RUSTFLAGS=-Ctarget-feature=+crt-static CARGO_PROFILE_RELEASE_LTO=false CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 cargo build --locked --release --target "$TARGET" -p podssh-cli && INTEROP_ONLY="keygen agent" sh scripts/interop.sh "$BIN"'
SETUP='for p in sshd sshd-session sshd.pam dropbear python3 podssh tmux ssh-agent Xvfb Xvnc x0vncserver; do pkill -x "$p"; done; true'
LIMIT=3600
