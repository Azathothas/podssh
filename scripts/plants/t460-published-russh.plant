# T-460: the published russh 0.65.0 in place of vendor/russh (the patch's
# line of [patch.crates-io] gone, the lock back on crates.io's source): a
# failure with 15 bytes after the default keepalive ends the connection
# again, so the quiet session against the stand-in of x/crypto/ssh must fail.
# On the runner, not in the build image: the harness starts containers of
# its own (Go's image, Alpine's).
ENTRY=T-460
GROUP=host-gossh
EXPECT='^FAIL +go-ssh\.quiet\.failure\.default '
RUN='cargo build --locked -p podssh-cli && PODSSH_ENGINE=docker sh scripts/interop-go-ssh.sh "$PWD/target/debug/podssh"'
LIMIT=2400
