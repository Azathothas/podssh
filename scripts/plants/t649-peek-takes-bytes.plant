# T-649: the relay role reads the ClientHello of a published name, where it
# must peek at it, so the node's TLS gets the visitor's bytes without their
# start; the test of the published name, whose handshake must reach the
# node's server, must fail.
ENTRY=T-649
GROUP=resume
EXPECT='test a_published_name_reaches_the_node_s_server_with_its_own_certificate \.\.\. FAILED'
RUN='cargo test --locked -p podssh-relay --features serve,plain-ws --test relay_serve_publish -- a_published_name_reaches_the_node_s_server_with_its_own_certificate'
