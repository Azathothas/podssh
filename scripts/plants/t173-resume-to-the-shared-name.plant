# T-173: the client sends each link of a session to the name that it was
# given, not to the process that named itself in its offer, so that behind
# one name that two processes share a resume reaches the other one, which
# does not know the session. The test of two processes behind one name must
# then see the session end before its bytes came back.
ENTRY=T-173
GROUP=resume
EXPECT='did not live on its cuts'
RUN='cargo test --locked -p podssh-relay --features serve,plain-ws --test session_relay_resume -- behind_one_name'
