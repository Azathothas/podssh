# T-173: the client does not know the relay role's refusal of a new session
# for its budget, so a session past it fails at its handshake (69) where the
# contract's road would carry it; the test of podssh proxy past a budget of
# one session must fail.
ENTRY=T-173
GROUP=cli-tests
EXPECT='test serve_layer::ssh_layer::a_new_session_past_the_role_s_budget_goes_on_the_contract_s_road_with_one_line \.\.\. FAILED'
# The role's harness asks for Python and openssl, which the build image lacks:
# with no SETUP the test said it did not run, and passed.
SETUP='if command -v apk >/dev/null; then apk add --no-cache python3 openssl >/dev/null; fi'
RUN='cargo test --locked -p podssh-cli --test relay_serve -- serve_layer::ssh_layer::a_new_session_past_the_role_s_budget_goes_on_the_contract_s_road_with_one_line'
