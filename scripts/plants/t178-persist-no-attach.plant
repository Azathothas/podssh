# T-178: --persist starts tmux without -A; the attach after the killed relay
# host finds a duplicate session and fails, so faults.persist.reattach must
# fail.
ENTRY=T-178
GROUP=ssh-faults
EXPECT='^FAIL +faults\.persist\.reattach '
RUN='RUSTFLAGS=-Ctarget-feature=+crt-static CARGO_PROFILE_RELEASE_LTO=false CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 cargo build --locked --release --target "$TARGET" -p podssh-cli && INTEROP_ONLY=faults sh scripts/interop.sh "$BIN"'
LIMIT=3600
