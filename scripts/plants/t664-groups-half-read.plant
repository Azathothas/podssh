# T-664: the file of the TLS groups is read in part, a line that does not
# read passed by, where the whole file is set aside; the test of the files
# that do not read must fail.
ENTRY=T-664
GROUP=resume
EXPECT='test tls::groups::tests::a_file_that_does_not_read_is_refused_whole \.\.\. FAILED'
RUN='cargo test --locked -p podssh-ws --lib -- tls::groups::tests'
LIMIT=1800
