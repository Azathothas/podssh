# T-435: `podssh ping NAME` keeps no word of the road that answered first, so
# `podssh status --net` shows no road for a node that it reached; the test of
# three ends on the stand-in relay must fail.
ENTRY=T-435
GROUP=cli-tests
EXPECT='test net_status::ping_names_each_road_and_status_lists_each_member_with_its_road \.\.\. FAILED'
# The stand-in relay asks for Python and openssl, which the build image lacks:
# with no SETUP the test said it did not run, and passed.
SETUP='if command -v apk >/dev/null; then apk add --no-cache python3 openssl >/dev/null; fi'
RUN='cargo test --locked -p podssh-cli --test net -- net_status'
LIMIT=2400
