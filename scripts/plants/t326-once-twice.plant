# T-326: the relay role keeps no token of one session that an upgrade
# spent, so a hop that read one in cleartext could take a second upgrade
# with it; the test's second use is then taken, where it must be refused.
ENTRY=T-326
GROUP=resume
EXPECT='a second use is refused'
RUN='cargo test --locked -p podssh-relay --features serve --test relay_serve_cleartext -- a_token_of_one_session_works_once'
