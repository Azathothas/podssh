# T-620: the hook of the expiry gives the node its next pair but leaves the
# first one in the place that the renewal and the rotation read, so the next
# pair is never renewed and its stop token never rotated; the test through
# the stand-in's first pair and the role's next one (Python and openssl for
# the harness's relays) must fail.
ENTRY=T-620
GROUP=resume-cli
EXPECT='test a_node_that_goes_on_with_its_next_pair_renews_and_rotates_that_one \.\.\. FAILED'
SETUP='{ command -v python3 && command -v openssl; } >/dev/null || apk add --no-cache python3 openssl'
RUN='cargo test --locked -p podssh-cli --test relay_serve_node -- a_node_that_goes_on_with_its_next_pair_renews_and_rotates_that_one'
LIMIT=1800
